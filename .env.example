# Copy to .env and export, or set these in your service manager. Every AI backend is optional.

# Where the SQLite file, cached covers, rendered spines and audio live.
TBR_DATA_DIR=./data

# Language model: any OpenAI-compatible chat-completions endpoint (llama.cpp, vLLM, Ollama, a hosted API).
# Unset = no summaries, no similar-book suggestions, no voice librarian.
#TBR_LLM_URL=http://localhost:11434/v1/chat/completions
#TBR_LLM_MODEL=your-model-name
#TBR_LLM_API_KEY=not-needed
# Extra JSON merged into every chat request. The default disables "thinking" on llama.cpp/Qwen-style servers.
#TBR_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Text-to-speech: any OpenAI-compatible /v1/audio/speech endpoint (Kokoro-FastAPI, OpenAI).
# Unset = no "Listen" button and text-only voice-chat replies.
#TBR_TTS_URL=http://localhost:8880/v1/audio/speech
#TBR_TTS_MODEL=kokoro
#TBR_TTS_VOICE=af_heart

# Speech-to-text runs locally with faster-whisper (pip install 'tbr-shelf[voice]'). Model size:
#TBR_STT_MODEL=small

# Outbound request timeout. Generous by default so an idle local model has time to load.
#TBR_REQUEST_TIMEOUT_S=180

# Directory containing NotoSans-Regular.ttf / NotoSans-Bold.ttf if they are not in a standard place.
#TBR_FONT_DIR=/usr/share/fonts/truetype/noto
